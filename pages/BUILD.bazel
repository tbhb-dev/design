load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

# This package's files, chained into //:repo_files for the whole-tree checks.
repo_files()

copy_file(
    name = "pages_workflow",
    src = "//:.github/workflows/pages.yml",
    out = "pages-workflow.yml",
)

js_test(
    name = "pages_runners_test",
    args = ["$(rootpath :pages_workflow)"],
    data = [
        "runner-policy.mjs",
        ":pages_workflow",
    ],
    entry_point = "pages_runners_test.mjs",
)

js_test(
    name = "runner_policy_test",
    data = [
        "runner-policy.mjs",
    ],
    entry_point = "runner_policy_test.mjs",
)

# GitHub Pages runs Jekyll over an artifact without this file, and Jekyll
# drops the directories whose names start with an underscore, such as
# Astro's _astro/.
write_file(
    name = "nojekyll",
    out = ".nojekyll",
    content = [],
)

# The whole of design.tbhb.dev as GitHub Pages serves it: the Astro site at
# the root, each Storybook under /storybook/<framework>/, and .nojekyll.
# `bazel build //pages` writes it, and the pages workflow uploads it.
copy_to_directory(
    name = "pages",
    srcs = [
        ":nojekyll",
        "//site:dist",
        "//storybook/astro:dist",
        "//storybook/html:dist",
        "//storybook/react:dist",
        "//storybook/web-components:dist",
    ],
    replace_prefixes = {
        "pages/.nojekyll": ".nojekyll",
        "site/dist": "",
        "storybook/astro/dist": "storybook/astro",
        "storybook/html/dist": "storybook/html",
        "storybook/react/dist": "storybook/react",
        "storybook/web-components/dist": "storybook/web-components",
    },
)

# The artifact holds the site's index page and .nojekyll at its root.
js_test(
    name = "pages_test",
    args = ["$(rootpath :pages)"],
    data = [":pages"],
    entry_point = "pages_test.mjs",
)

js_test(
    name = "pages_paths_test",
    args = ["$(rootpath :pages)"],
    data = [
        "path-policy.mjs",
        ":pages",
    ],
    entry_point = "pages_paths_test.mjs",
)

js_test(
    name = "path_policy_test",
    data = ["path-policy.mjs"],
    entry_point = "path_policy_test.mjs",
)
