load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("@tbhb_rules_tokens//:defs.bzl", "radix_palette_files", "radix_palettes", "tokens_test")

# This package's files, chained into //:repo_files for the whole-tree checks.
repo_files()

# npm_translate_lock in MODULE.bazel reads package.json, and the
# tokens-* packages build from the resolver.
exports_files([
    "package.json",
    "tokens.resolver.json",
])

# The DTCG token files, in three layers:
# - base/: values with no meaning yet, the palettes among them;
# - semantic/: themes that map roles onto palettes, and colors named for
#   what they do;
# - component/: values for one component, over the semantic tokens.
# Only DTCG documents live here; the tokens-* packages transform them.

# The palette library: Radix Colors scales, generated into palettes/ with
# their MIT sidecars, in base/palettes/. `bazel run //packages/tokens:palettes`
# rewrites them,
# and palettes_test fails when a committed file differs. A theme maps roles
# onto these scales; tokens_css leaves out any scale no theme uses.
SCALES = [
    "amber",
    "blue",
    "bronze",
    "brown",
    "crimson",
    "cyan",
    "gold",
    "grass",
    "gray",
    "green",
    "indigo",
    "iris",
    "jade",
    "lime",
    "mauve",
    "mint",
    "olive",
    "orange",
    "pink",
    "plum",
    "purple",
    "red",
    "ruby",
    "sage",
    "sand",
    "sky",
    "slate",
    "teal",
    "tomato",
    "violet",
    "yellow",
]

radix_palettes(
    name = "radix",
    scales = SCALES,
)

write_source_files(
    name = "palettes",
    files = {"base/palettes/" + f: ":radix/" + f for f in radix_palette_files(SCALES)},
)

TOKENS = glob(["**/*.tokens.json"])

filegroup(
    name = "tokens",
    srcs = TOKENS,
    visibility = ["//packages/tokens-css:__pkg__"],
)

# The palette files in the output tree, for tools that run there, such as
# tokens-js's palettes.js.
copy_to_bin(
    name = "palette_files",
    srcs = ["base/palettes/" + f for f in radix_palette_files(SCALES) if f.endswith(".json")],
    visibility = ["//packages/tokens-js:__pkg__"],
)

# Semantic source in the output tree, for tokens-js's documentation metadata.
copy_to_bin(
    name = "color_file",
    srcs = ["semantic/color.tokens.json"],
    visibility = ["//packages/tokens-js:__pkg__"],
)

# Every theme × mode resolves, and text meets WCAG AA on the surfaces it
# sits on, in each of them.
tokens_test(
    name = "tokens_test",
    srcs = TOKENS,
    contrast = [
        {
            "background": bg,
            "foreground": fg,
        }
        for bg in [
            "color.background",
            "color.surface",
        ]
        for fg in [
            "color.text",
            "color.text-muted",
        ]
    ] + [
        {
            "background": "color.background",
            "foreground": "color.%s.text" % role,
        }
        for role in [
            "accent",
            "success",
            "warning",
            "danger",
            "info",
        ]
    ] + [
        {
            "background": "color.%s.%s" % (role, fill),
            "foreground": "color.%s.contrast" % role,
        }
        for role in [
            "accent",
            "success",
            "warning",
            "danger",
            "info",
        ]
        for fill in [
            "solid",
            "solid-hover",
        ]
    ],
    resolver = "tokens.resolver.json",
)

# The package as the workspace links it: the DTCG documents, by their paths
# here, such as `@tbhb-dev/tokens/tokens.resolver.json`.
npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        "tokens.resolver.json",
        ":tokens",
    ] + glob(["base/palettes/*.license"]),
    visibility = ["//visibility:public"],
)
