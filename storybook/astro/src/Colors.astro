import { COLORS, SCALES, STEPS, USES, label, swatchName, swatchStep, variable } from "./palette.ts";
---

<main class="tbhb-page tbhb-colors">
  <h1>Colors</h1>
  <p>{COLORS}</p>
  <fieldset class="tbhb-toggle">
    <legend>Scales</legend>
    <label><input type="radio" name="tbhb-variant" value="solid" checked /> Solid</label>
    <label><input type="radio" name="tbhb-variant" value="alpha" /> Alpha</label>
  </fieldset>
  <div class="tbhb-grid">
    <span></span>
    {USES.map((use) => <span class="tbhb-use" style={`grid-column: span ${use.steps}`}>{use.name}</span>)}
    <span></span>
    {STEPS.map((step) => <span class="tbhb-step">{step}</span>)}
    {
      SCALES.map((scale) => (
        <>
          <span class="tbhb-name">{label(scale)}</span>
          {STEPS.map((step) => (
            <div>
              {[false, true].map((alpha) => (
                <button
                  type="button"
                  class:list={["tbhb-swatch", alpha ? "tbhb-alpha" : "tbhb-solid"]}
                  data-scale={scale}
                  data-step={swatchStep(step, alpha)}
                  aria-label={swatchName(scale, step, alpha)}
                  title={variable(scale, step, alpha)}
                  style={`--swatch: var(${variable(scale, step, alpha)})`}
                />
              ))}
            </div>
          ))}
        </>
      ))
    }
  </div>
</main>
