{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "1": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "2": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "3": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "4": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "5": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "6": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "7": {
        "$value": {
          "value": 1.875,
          "unit": "rem"
        }
      },
      "8": {
        "$value": {
          "value": 2.25,
          "unit": "rem"
        }
      },
      "9": {
        "$value": {
          "value": 3,
          "unit": "rem"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 700
      }
    }
  }
}
