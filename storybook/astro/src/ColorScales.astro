const ROLES = ["neutral", "accent", "success", "warning", "danger", "info"];
const STEPS = Array.from({ length: 12 }, (_, i) => i + 1);
const label = (role: string) => role[0].toUpperCase() + role.slice(1);
const chip = (role: string, fill: string) =>
  `background: var(--color-${role}-${fill}); color: var(--color-${role}-contrast); padding: var(--space-1) var(--space-3); border-radius: var(--radius-2)`;
---

<main style="padding: var(--space-4)">
  <h1>Color scales</h1>
  <p>Each role's 12 steps in the current theme and mode: 1–2 app backgrounds, 3–5 component backgrounds, 6–8 borders, 9–10 solid fills, 11–12 text.</p>
  {
    ROLES.map((role) => (
      <section>
        <h2>{label(role)}</h2>
        <ol style="display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--space-1); list-style: none; padding: 0">
          {STEPS.map((step) => (
            <li>
              <div style={`height: 3rem; border-radius: var(--radius-2); background: var(--role-${role}-${step})`} />
              <span style="color: var(--color-text-muted)">{step}</span>
            </li>
          ))}
        </ol>
        {role !== "neutral" && (
          <p style="display: flex; gap: var(--space-2); align-items: center">
            <span style={chip(role, "solid")}>Solid</span>
            <span style={chip(role, "solid-hover")}>Solid hover</span>
            <span style={`color: var(--color-${role}-text)`}>Text</span>
          </p>
        )}
      </section>
    ))
  }
</main>
