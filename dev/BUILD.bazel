load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

# This package's files, chained into //:repo_files for the whole-tree checks.
repo_files()

# Every dev server, at the prefix it has on design.tbhb.dev. Each server
# runs with its prefix as its base path, so the proxy forwards paths as
# they are.
SERVERS = {
    "/": "//site:dev",
    "/storybook/astro/": "//storybook/astro:dev",
    "/storybook/html/": "//storybook/html:dev",
    "/storybook/react/": "//storybook/react:dev",
    "/storybook/web-components/": "//storybook/web-components:dev",
}

# `bazel run //dev -- --port 4300` serves every dev server behind one port.
# It suits a background job: no prompts, no browser, one "ready" line, and
# exit 0 on SIGINT or SIGTERM. The routes go in env, not args, so a program
# that starts the binary directly keeps them.
js_binary(
    name = "dev",
    data = SERVERS.values() + ["routing.mjs"],
    entry_point = "proxy.mjs",
    env = {
        "DEV_ROUTES": ";".join(["{}=$(rlocationpath {})".format(prefix, target) for prefix, target in SERVERS.items()]),
    },
)

# The proxy over a copy of every server's sources: it refuses a bad
# argument, serves / and each Storybook once every server answers, and exits
# 0 on SIGTERM.
SOURCES = ["//site:sources"] + [
    "//storybook/{}:sources".format(framework)
    for framework in [
        "astro",
        "html",
        "react",
        "web-components",
    ]
]

js_test(
    name = "dev_test",
    args = ["$(rootpath :dev)"],
    # The site's sources are read and copied as they are, from another
    # package, so they stay in the source tree.
    copy_data_to_bin = False,
    data = [":dev"] + SOURCES,
    entry_point = "dev_test.mjs",
    env = {"WORKSPACE_FILES": " ".join(["$(rootpaths {})".format(s) for s in SOURCES])},
)
