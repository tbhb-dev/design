const storybooks = [
  { name: "Web Components", path: "web-components" },
  { name: "React", path: "react" },
  { name: "HTML", path: "html" },
  { name: "Astro", path: "astro" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tbhb.dev design system</title>
  </head>
  <body>
    <h1>tbhb.dev design system</h1>
    <h2>Storybooks</h2>
    <ul>
      {
        storybooks.map(({ name, path }) => (
          <li>
            <a href={`/storybook/${path}/`}>{name}</a>
          </li>
        ))
      }
    </ul>
  </body>
</html>
