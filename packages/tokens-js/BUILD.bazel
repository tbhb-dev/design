load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

# This package's files, chained into //:repo_files for the whole-tree checks.
repo_files()

# npm_translate_lock in MODULE.bazel reads it.
exports_files(["package.json"])

js_binary(
    name = "palettes_js_tool",
    data = ["palette-values.mjs"],
    entry_point = "palettes_js.mjs",
)

# Every palette value in one module, for the Storybooks' Colors page.
js_run_binary(
    name = "palettes_js",
    srcs = ["//packages/tokens:palette_files"],
    outs = ["palettes.js"],
    args = [
        package_name() + "/palettes.js",
        "$(rootpaths //packages/tokens:palette_files)",
    ],
    tool = ":palettes_js_tool",
)

# Semantic color names and their source groups, for documentation consumers.
js_binary(
    name = "colors_js_tool",
    data = ["color-groups.mjs"],
    entry_point = "colors_js.mjs",
)

js_run_binary(
    name = "colors_js",
    srcs = ["//packages/tokens:color_file"],
    outs = ["colors.js"],
    args = [
        package_name() + "/colors.js",
        "$(rootpath //packages/tokens:color_file)",
    ],
    tool = ":colors_js_tool",
)

# The package as the workspace links it: a dependency on @tbhb-dev/tokens-js
# gets palette values and semantic color groups as importable modules.
npm_package(
    name = "pkg",
    srcs = [
        "colors.d.ts",
        "package.json",
        "palettes.d.ts",
        ":colors_js",
        ":palettes_js",
    ],
    visibility = ["//visibility:public"],
)
