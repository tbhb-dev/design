{
  "workspaces": {
    ".": {
      "entry": ["dev/proxy.mjs", "dev/dev_test.mjs", "pages/*_test.mjs"],
      "project": ["dev/**/*.mjs", "pages/**/*.mjs"],
      "ignoreDependencies": [
        "@vitest/coverage-v8",
        "vitest",
        "typescript-eslint"
      ],
      "typescript": {
        "config": ["tsconfig.json"]
      },
      "vitest": {
        "config": ["vitest.config.mjs"]
      }
    },
    "packages/*": {
      "entry": ["palettes_js.mjs"],
      "project": ["**/*.{ts,mjs}"]
    },
    "site": {
      "project": ["**/*.{ts,mjs,astro}"],
      "entry": ["astro.config.mjs", "src/pages/**/*.astro"]
    },
    "storybook/*": {
      "entry": [
        ".storybook/{main,preview}.ts",
        "src/**/*.stories.{ts,tsx}",
        "src/env.d.ts"
      ],
      "project": [
        "**/*.{ts,tsx,astro}",
        ".storybook/**/*.ts",
        ".storybook/**/*.css"
      ]
    },
    "storybook/astro": {
      "entry": [
        ".storybook/{main,preview}.ts",
        "src/**/*.stories.ts",
        "src/env.d.ts"
      ],
      "project": ["**/*.{ts,astro}", ".storybook/**/*.{ts,css}"]
    },
    "storybook/react": {
      "entry": [
        ".storybook/{main,preview}.ts",
        "src/**/*.stories.tsx",
        "src/env.d.ts"
      ],
      "project": ["**/*.{ts,tsx}", ".storybook/**/*.{ts,css}"],
      "ignoreDependencies": ["react-dom"]
    }
  }
}
